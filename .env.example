# --- Site ---
NEXT_PUBLIC_SITE_URL=https://pda-website-q9fd.onrender.com

# --- Enquiry destination (preferred: Google Sheets via Apps Script) ---
# When set, the form POSTs directly here and the API route below is NOT used.
# This lets the site run on any host, including GitHub Pages / Cloudflare Pages / Netlify.
# Create the sheet + script using apps-script/Code.gs, deploy as Web App, paste the URL below.
NEXT_PUBLIC_SHEETS_URL=

# --- Fallback: SMTP email notifications (used only when NEXT_PUBLIC_SHEETS_URL is empty) ---
# Where new enquiries are emailed to (admin inbox)
ADMIN_EMAIL=purvangdoshica@gmail.com

# SMTP transport (Gmail example — see README for how to create a Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=purvangdoshica@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM="Purvang Doshi Website <purvangdoshica@gmail.com>"

# --- Admin endpoint (view enquiries without email) ---
# Any long random string. GET /api/admin/enquiries requires this as `?key=...`.
# If unset, the admin endpoint is disabled.
ADMIN_KEY=change-me-to-a-long-random-string
